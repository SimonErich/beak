# syntax=docker/dockerfile:1

# Beak panel (Flutter web) image.
#
# The panel is a normal Flutter web app. It depends on obers_ui by pinned git
# commit, so it resolves identically inside a container and on a developer's
# machine — no injected overrides, no sibling checkout. Build from the repo
# root:
#
#   docker build -f deploy/Dockerfile.web -t beak-web .
#
# The panel's API origin comes from `beak.yaml` (`api.baseUrl`), compiled in
# as a `String.fromEnvironment` default. For a demo where the server is
# published on host port 8080, the browser reaches it at that default; for a
# real deploy pass `--dart-define=BEAK_API_BASE_URL=https://api.example.com`
# to the build below, or set `api.baseUrl: auto` to call the serving origin.

FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app
COPY . .

# Flutter refuses to touch a repo it does not "own" (root user in CI images).
RUN git config --global --add safe.directory '*'

WORKDIR /app/packages/beak_cli
RUN dart pub get

WORKDIR /app/examples/clean_beak_config
RUN flutter pub get
RUN dart run ../../packages/beak_cli/bin/beak.dart prepare
ARG BEAK_API_BASE_URL=http://localhost:8080
RUN flutter build web --release --dart-define=BEAK_API_BASE_URL=${BEAK_API_BASE_URL}

# --- Runtime image: static files served by nginx ---
FROM nginx:alpine AS runtime

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/examples/clean_beak_config/build/web /usr/share/nginx/html

EXPOSE 80
