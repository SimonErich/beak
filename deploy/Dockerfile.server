# Beak backend server image.
#
# The backend is pure Dart: it depends on beak_backend/beak_core/worm and never
# on Flutter libraries. Its shared pubspec requires a Flutter SDK to resolve.
# The dependency graph has a build hook (sqlite3), which `dart compile exe`
# refuses, so the server and the migrate CLI are built with `dart build cli`:
# each is a bundle (`bin/<name>` next to `lib/libsqlite3.so`) that runs from a
# slim Debian base and needs nothing installed beside it. Build from the REPO
# ROOT as context (Beak uses path dependencies, so the whole packages/ +
# examples/ tree must be present):
#
#   docker build -f deploy/Dockerfile.server -t beak-server .
#
# The .dockerignore at the repo root trims artifacts and the melos-managed
# pubspec_overrides.yaml, so resolution comes from each committed pubspec.yaml.

FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app
COPY . .
RUN git config --global --add safe.directory '*'

# Resolve and compile the example's server. Swap this path for your own
# project when you deploy it: the entrypoints are the same two files in
# every Beak project, because `beak prepare` writes them.
WORKDIR /app/packages/beak_cli
RUN dart pub get

WORKDIR /app/examples/clean_beak_config
RUN flutter pub get
RUN dart run ../../packages/beak_cli/bin/beak.dart prepare
RUN dart build cli --target bin/serve.dart --output /app/out/serve
# The worm CLI (migrate / db:seed) as a second bundle, so schema and seed
# steps run from the same image (see the migrate service in the compose file).
RUN dart build cli --target bin/migrate.dart --output /app/out/migrate

# --- Runtime image: glibc + CA roots for TLS to Postgres. The SQLite library
# travels inside each bundle, so nothing else is installed. ---
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Ship each bundle as a directory: `bin/` and `lib/` have to stay side by side.
COPY --from=build /app/out/serve/bundle /opt/beak/server
COPY --from=build /app/out/migrate/bundle /opt/beak/migrate

# BeakBackendConfig defaults to host 0.0.0.0; PORT is read from the environment.
ENV PORT=8080
EXPOSE 8080

ENTRYPOINT ["/opt/beak/server/bin/serve"]
