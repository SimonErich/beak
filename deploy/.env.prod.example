# Copy to deploy/.env.prod and change every credential before deploying anywhere
# real. Hostnames here (postgres, minio) are the compose service names, reached
# over the internal network on their container ports (not the remapped host
# ports the dev docker-compose.yml uses).

PORT=8080

# Postgres service, internal port 5432.
DATABASE_URL=postgres://beak:beak@postgres:5432/beak

# Object storage. Use "memory" to skip S3 entirely, or "s3" for MinIO/S3.
BEAK_STORAGE_DRIVER=s3
BEAK_S3_ENDPOINT=http://minio:9000
BEAK_S3_BUCKET=beak-uploads
BEAK_S3_ACCESS_KEY=beak
BEAK_S3_SECRET_KEY=beaksecret
BEAK_S3_REGION=us-east-1
BEAK_S3_USE_PATH_STYLE=true

# Secret used to sign/verify auth tokens. Generate a real one.
BEAK_AUTH_SECRET=change-me-in-prod
