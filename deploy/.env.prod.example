# Copy to deploy/.env.prod and change every credential before deploying anywhere
# real. The hostname here (postgres) is the compose service name, reached over
# the internal network on its container port (not the remapped host port the dev
# docker-compose.yml uses).

PORT=8080

# Production markers: worm refuses migrate:fresh and migrate:refresh without
# --force under this value.
WORM_ENV=production

# Postgres service, internal port 5432. The password must match
# POSTGRES_PASSWORD in docker-compose.prod.yml.
DATABASE_URL=postgres://beak:beak@postgres:5432/beak

# Uploads go to the `uploads` volume the compose file mounts at /data/uploads.
# The public URL is what the browser is given, so it has to be the address the
# API is reachable at.
BEAK_STORAGE_DRIVER=local
BEAK_LOCAL_ROOT_DIR=/data/uploads
BEAK_LOCAL_PUBLIC_BASE_URL=http://localhost:8080/uploads
