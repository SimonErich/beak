{
  "type": "delete",
  "table": "users",
  "where": {
    "type": "or",
    "left": {
      "type": "and",
      "left": {
        "type": "leaf",
        "field": "is_active",
        "operator": "eq",
        "value": false
      },
      "right": {
        "type": "leaf",
        "field": "age",
        "operator": "lt",
        "value": 18
      }
    },
    "right": {
      "type": "leaf",
      "field": "role",
      "operator": "eq",
      "value": "banned"
    }
  }
}
