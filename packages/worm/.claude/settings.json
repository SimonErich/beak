{
  "agent": "default",
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/forbid-generated-files.sh",
            "if": "Edit(*.g.dart)|Write(*.g.dart)"
          }
        ]
      }
    ]
  }
}