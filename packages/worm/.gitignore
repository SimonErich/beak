.dart_tool/

# Avoid committing pubspec.lock for library packages; see
# https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock

# peakz orchestrator runtime artifacts — keep the planning state
# (epic.yaml, work-item YAMLs, STATE.md, etc.) but never commit the
# per-run runtime logs, retrieval snapshots, or compiled dispatches.
.peakz/runtime/
.peakz/plans/**/*-pipeline.json
.peakz/plans/**/retrieval-snapshot.json
.peakz/plans/**/compiled-dispatch/
.peakz/reports/
