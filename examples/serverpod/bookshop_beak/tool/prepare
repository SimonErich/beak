#!/usr/bin/env bash
# Regenerates this package's Beak parts (`*.beak.dart`) and `lib/beak/registry.g.dart`.
#
# `beak prepare` is written for a whole Beak app. In a models-only package it
# also writes the app, panel, server and entrypoint files (which belong to
# bookshop_admin here) and imports `package:beak/beak.dart` in the registry
# (this package depends on beak_core only, so the server never pulls in
# Flutter). This script keeps what belongs here and fixes that one import.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
dart ../../../packages/beak_cli/bin/beak.dart prepare
rm -rf bin lib/main.dart lib/beak/app.g.dart lib/beak/panel.g.dart lib/beak/server.g.dart
sed -i "s#package:beak/beak.dart#package:beak_core/beak_core.dart#" lib/beak/registry.g.dart
