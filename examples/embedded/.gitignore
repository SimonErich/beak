# Dart / Flutter
.dart_tool/
build/
.packages
pubspec.lock

# Beak generates these at their canonical paths so `flutter run`, IDE run
# buttons and `dart compile exe` work with no flags. They are regenerated by
# every `beak` command, so they are not worth reviewing.
# Run `beak eject main` if you would rather commit them.
/lib/main.dart
/bin/serve.dart
/bin/migrate.dart

# Secrets
.env

# Uploads land here until BEAK_STORAGE_DRIVER points somewhere else.
/storage/

# The default SQLite database, so the first `beak dev` needs no setup. A real
# deployment sets DATABASE_URL and this file never appears.
/*.db
/*.db-journal
/*.db-wal
/*.db-shm
